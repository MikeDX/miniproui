{
  "name": "miniproui",
  "version": "0.1.0",
  "description": "Cross-platform UI for XGecu chip programmers",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite dev",
    "dev:web": "MINIPRO_WEBUSB=1 npm run wasm && MINIPRO_WEBUSB=1 vite dev",
    "build": "vite build",
    "build:web": "MINIPRO_WEBUSB=1 npm run wasm && MINIPRO_WEBUSB=1 vite build && node scripts/copy-db.mjs",
    "preview": "vite preview",
    "preview:web": "MINIPRO_WEBUSB=1 vite preview",
    "wasm": "node scripts/build-wasm.mjs",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
